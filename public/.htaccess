# Apache (cPanel) config. Vite copies this file into dist/ on every build.
#
# The build pre-renders each page to its own HTML file (scripts/prerender.mjs):
#   /                -> index.html
#   /services/iot    -> services/iot.html
# Clean URLs are mapped to those files below. Old addresses from the previous
# (PHP) website are 301-redirected to their new pages, and anything else gets
# 404.html with a real 404 status.

# Don't list folder contents, and don't add trailing slashes to folder names
# (e.g. /blog must serve blog.html, not redirect to /blog/).
Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Only the main website uses these rules. Subdomains whose folders live
  #    inside public_html (invoice.neuralarc.com, website.neuralarc.com) are
  #    left alone.
  RewriteCond %{HTTP_HOST} !^(www\.)?neuralarc\.com$ [NC]
  RewriteRule ^ - [L]

  # 1. One canonical origin: https://www.neuralarc.com (matches the canonical
  #    tags and sitemap). Redirects http:// and the bare domain in one hop.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^neuralarc\.com$ [NC]
  RewriteRule ^ https://www.neuralarc.com%{REQUEST_URI} [L,R=301]

  # 1b. Old website addresses -> new pages, so Google's existing listings
  #     (e.g. /about-us.php) pass to the right page instead of a dead end.
  #     index/home use THE_REQUEST so Apache's own internal /index.html
  #     lookup for "/" is never redirected.
  RewriteCond %{THE_REQUEST} \s/+(index|home)(\.php|\.html?)?[\s?] [NC]
  RewriteRule ^ / [L,R=301]
  # (never matches "/about" itself, which would loop)
  RewriteRule ^about(-us(\.php)?|\.php)$ /about [L,R=301,NC]
  RewriteRule ^contact-us(\.php)?$ /contact [L,R=301,NC]
  RewriteRule ^contact\.php$ /contact [L,R=301,NC]
  RewriteRule ^services?\.php$ /Services [L,R=301,NC]
  RewriteRule ^(products?|productes)\.php$ /Productes [L,R=301,NC]
  RewriteRule ^gallery\.php$ /Gallery [L,R=301,NC]
  RewriteRule ^(trainings?|courses?|internships?)\.php$ /TrainingList [L,R=301,NC]
  RewriteRule ^blogs?\.php$ /blog [L,R=301,NC]
  # Old pages found in Google's index (Search Console, 2026-10-28)
  RewriteRule ^iot-(solutions?|services?)\.php$ /services/iot [L,R=301,NC]
  RewriteRule ^data-science-services?\.php$ /services/ai-ml-data-science [L,R=301,NC]
  RewriteRule ^data-(collection|aggregation)-device\.php$ /products/smart-agri-solution [L,R=301,NC]
  # Lowercase guesses for pages whose real URL is capitalised. (These names
  # are also folders, which would otherwise return "forbidden".)
  # Case-SENSITIVE on purpose: with [NC] these would also match the real
  # capitalised URL (e.g. /TrainingList) and redirect it to itself forever.
  RewriteRule ^services$ /Services [L,R=301]
  RewriteRule ^products$ /Productes [L,R=301]
  RewriteRule ^(training|traininglist)$ /TrainingList [L,R=301]
  RewriteRule ^gallery$ /Gallery [L,R=301]
  # Any other old .php page: drop the extension. If that isn't a page either,
  # the visitor lands on the 404 page below. (404.php is our own handler.)
  RewriteCond %{REQUEST_URI} !^/404\.php$ [NC]
  RewriteRule ^(.+)\.php$ /$1 [L,R=301,NC]

  # 2. Remove trailing slashes (/blog/ -> /blog), except the home page.
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 3. Hide the .html files: /services/iot.html -> /services/iot
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  #    (not index/404, and not Google's Search Console verification file,
  #    which must stay reachable at its exact .html address)
  RewriteCond %1 !^(index|404|google[0-9a-f]+)$ [NC]
  RewriteRule ^ /%1 [L,R=301]

  # 4. Serve the pre-rendered page for a clean URL when one exists.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # 5. Anything else that isn't a real file: the "page not found" page, via
  #    404.php so it keeps a real 404 status. (This host shows a plain-text
  #    error instead of honouring ErrorDocument, and [R=404] gave an empty
  #    page.) Folders without an index file (e.g. /why-choose-us) land here too.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /404.php [L]
</IfModule>

# Fallback if the rule above doesn't apply.
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  # Built JS/CSS/images in /assets have content hashes in their names, so they
  # can be cached for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML must always be revalidated, so new deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
